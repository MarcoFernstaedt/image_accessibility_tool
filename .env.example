# Required: OpenAI API key for GPT Vision + Text-to-Speech
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Required: Arcjet API key for rate limiting and bot protection
# https://app.arcjet.com
ARCJET_KEY=ajkey_...

# Required in production: the canonical base URL of your deployment
# On Vercel this is auto-detected via VERCEL_URL — only set this for custom domains
NEXT_PUBLIC_BASE_URL=https://your-domain.vercel.app
